# Copy to ops/vm.env (gitignored) and fill in. Sourced by every ops/*.sh script.
GRAFIN_GCP_PROJECT=your-project-id          # the project that OWNS THE GPU VM (may differ from the platform's)
GRAFIN_GCLOUD_ACCOUNT=                      # optional: gcloud account with access to that project (e.g. you@office.com)
GRAFIN_IAP=                                 # optional: 1 = SSH/SCP through IAP (orgs that block public SSH)
GRAFIN_GCP_ZONE=asia-southeast2-a          # pick a zone with T4 quota: gcloud compute accelerator-types list --filter=name=nvidia-tesla-t4
GRAFIN_VM_NAME=grafin-train
GRAFIN_VM_TYPE=n1-standard-16              # 60 GB RAM: 4 parallel HI-Small jobs, or 2 parallel HI-Medium jobs.
GRAFIN_GPU_COUNT=4
GRAFIN_IMAGE_FAMILY=common-cu124-ubuntu-2204-py310   # list: see ops/vm_create.sh
GRAFIN_DISK_GB=300
GRAFIN_GCS_BUCKET=                         # optional; empty = use ops/vm_push.sh (direct scp) instead of GCS
GRAFIN_EXTRA=cu124
# Where everything lands on the VM (code, data, runs, logs). Created owner-only (chmod 700).
GRAFIN_VM_DIR=/home/<your-vm-user>/grafin
