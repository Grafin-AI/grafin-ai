# Copy this file to deploy.env (gitignored) and edit, OR export these in your shell.
# These names match the GitHub Actions repo variables used by deploy.yml.
GCP_PROJECT=your-gcp-project
GCP_REGION=asia-southeast1

# Runtime env vars for the Cloud Run service (set with `gcloud run services update
# garda-backend --update-env-vars ...`; not read by `make deploy` itself):
# GARDA_EXPLANATION_STORE=firestore        # postgres (default) | firestore
# GARDA_FIRESTORE_PROJECT=garda-ai-dev-01  # empty = ADC default project
# GARDA_FIRESTORE_DATABASE=(default)
# GARDA_CORS_ORIGINS=https://garda-ai-dev-01.web.app,https://garda-ai-dev-01.firebaseapp.com
