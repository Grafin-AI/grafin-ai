# Database
GARDA_DATABASE_URL=postgresql+asyncpg://garda:garda@localhost:5432/garda
# Redis
GARDA_REDIS_URL=redis://localhost:6379/0
# App
GARDA_ENV=development
GARDA_LOG_LEVEL=INFO
# Auth — REQUIRED in non-development envs: a random secret of >= 32 chars
# (the app fails to start with the default/short secret when GARDA_ENV != development).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GARDA_JWT_SECRET=change-me-in-prod
GARDA_JWT_ACCESS_TTL_MIN=15
GARDA_JWT_REFRESH_TTL_DAYS=7
