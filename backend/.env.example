# Database
GRAFIN_DATABASE_URL=postgresql+asyncpg://grafin:grafin@localhost:5432/grafin
# Redis
GRAFIN_REDIS_URL=redis://localhost:6379/0
# App
GRAFIN_ENV=development
GRAFIN_LOG_LEVEL=INFO
# Auth — REQUIRED in non-development envs: a random secret of >= 32 chars
# (the app fails to start with the default/short secret when GRAFIN_ENV != development).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GRAFIN_JWT_SECRET=change-me-in-prod
GRAFIN_JWT_ACCESS_TTL_MIN=15
GRAFIN_JWT_REFRESH_TTL_DAYS=7
# Ingest write-path (Phase 2) — REQUIRED at startup (fail-fast, like the JWT secret).
# URL/token of the grafin-ai-scoring service, and the shared token producers present
# to the ingest endpoint. Set real values per environment; do not commit secrets.
GRAFIN_SCORING_URL=http://scoring:8000
GRAFIN_SCORING_TOKEN=change-me-scoring-token
GRAFIN_INGEST_TOKEN=change-me-ingest-token
GRAFIN_SCORING_TIMEOUT_S=5.0
GRAFIN_SCORING_RETRIES=2
