POSTGRES_USER=garda
POSTGRES_PASSWORD=garda
POSTGRES_DB=garda
GARDA_JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
GARDA_ENV=production
# Machine tokens (distinct from user JWTs). Ingest token must be >= 16 chars.
GARDA_SCORING_TOKEN=change-me-scoring-token
GARDA_INGEST_TOKEN=change-me-ingest-token-at-least-16-chars
# Absolute or relative path (from this compose file) to the dataset dir.
# Switching datasets? Run `make reset` (docker compose down -v) first: the old rows stay in pgdata.
GARDA_DATA_HOST_DIR=../garda-ai-data/HI-Small-ID
# Scoring: label_replay (default, label-derived) | precomputed (model scores).
# precomputed reads scores.csv from `garda-train export-scores --run <run-id>`:
#   GARDA_SCORER=precomputed
#   GARDA_SCORES_HOST_DIR=../garda-ai-training/runs/<run-id>/scores
GARDA_SCORER=label_replay
# Shown on the dashboard model card when model scores are served, e.g. "Multi-GNN PNA (HI-Small-ID)"
GARDA_MODEL_NAME=
# LLM explanations (backend): GARDA_LLM_PROVIDER = none | anthropic | gemini | ollama.
# MODEL/BASE_URL empty = provider default; BASE_URL is mainly for ollama (http://host:11434).
GARDA_LLM_PROVIDER=none
GARDA_LLM_API_KEY=
GARDA_LLM_MODEL=
GARDA_LLM_BASE_URL=
GARDA_LLM_TIMEOUT_S=20
# Host ports (change if something else already listens on these)
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
# Simulator replay knobs (profile: sim)
#   GARDA_BATCH_SIZE=1   -> one transaction per request (true real-time streaming)
#   GARDA_SPEED=10       -> 10x dataset time (dataset spans 2025-09-04..09-21)
GARDA_BATCH_SIZE=100
GARDA_SPEED=60
GARDA_MAX_GAP_S=2.0
