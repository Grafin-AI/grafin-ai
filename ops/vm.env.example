# Copy to ops/vm.env (gitignored) and fill in. Sourced by every ops/*.sh script.
GARDA_GCP_PROJECT=your-project-id          # the project that OWNS THE GPU VM (may differ from the platform's)
GARDA_GCLOUD_ACCOUNT=                      # optional: gcloud account with access to that project (e.g. you@office.com)
GARDA_IAP=                                 # optional: 1 = SSH/SCP through IAP (orgs that block public SSH)
GARDA_GCP_ZONE=asia-southeast2-a          # pick a zone with T4 quota: gcloud compute accelerator-types list --filter=name=nvidia-tesla-t4
GARDA_VM_NAME=garda-train
GARDA_VM_TYPE=n1-standard-16              # 60 GB RAM: 4 parallel HI-Small jobs, or 2 parallel HI-Medium jobs.
GARDA_GPU_COUNT=4
GARDA_IMAGE_FAMILY=common-cu124-ubuntu-2204-py310   # list: see ops/vm_create.sh
GARDA_DISK_GB=300
GARDA_GCS_BUCKET=                         # optional; empty = use ops/vm_push.sh (direct scp) instead of GCS
GARDA_EXTRA=cu124
