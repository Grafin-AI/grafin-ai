POSTGRES_USER=grafin
POSTGRES_PASSWORD=grafin
POSTGRES_DB=grafin
GRAFIN_JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
GRAFIN_ENV=production
# Machine tokens (distinct from user JWTs). Ingest token must be >= 16 chars.
GRAFIN_SCORING_TOKEN=change-me-scoring-token
GRAFIN_INGEST_TOKEN=change-me-ingest-token-at-least-16-chars
# Absolute or relative path (from this compose file) to the dataset dir.
# Switching datasets? Run `make reset` (docker compose down -v) first: the old rows stay in pgdata.
GRAFIN_DATA_HOST_DIR=../grafin-ai-data/HI-Small-ID
# Scoring: label_replay (default, label-derived) | precomputed (model scores).
# precomputed reads scores.csv from `grafin-train export-scores --run <run-id>`:
#   GRAFIN_SCORER=precomputed
#   GRAFIN_SCORES_HOST_DIR=../grafin-ai-training/runs/<run-id>/scores
GRAFIN_SCORER=label_replay
# Shown on the dashboard model card when model scores are served, e.g. "Multi-GNN PNA (HI-Small-ID)"
GRAFIN_MODEL_NAME=
# LLM explanations (backend): GRAFIN_LLM_PROVIDER = none | anthropic | gemini | ollama.
# MODEL/BASE_URL empty = provider default; BASE_URL is mainly for ollama (http://host:11434).
# Google: GRAFIN_LLM_PROVIDER=gemini with an AI Studio key; GRAFIN_LLM_MODEL=gemini-3.8-flash
# (default) or a Gemma model on the same API, e.g. gemma-4-31b-it. Allow ~30 s timeout.
GRAFIN_LLM_PROVIDER=none
GRAFIN_LLM_API_KEY=
GRAFIN_LLM_MODEL=
GRAFIN_LLM_BASE_URL=
GRAFIN_LLM_TIMEOUT_S=20
# Host ports (change if something else already listens on these)
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
# Simulator replay knobs (profile: sim)
#   GRAFIN_BATCH_SIZE=1   -> one transaction per request (true real-time streaming)
#   GRAFIN_SPEED=10       -> 10x dataset time (dataset spans 2025-09-04..09-21)
GRAFIN_BATCH_SIZE=100
GRAFIN_SPEED=60
GRAFIN_MAX_GAP_S=2.0
